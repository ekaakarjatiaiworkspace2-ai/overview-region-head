# Salin sebagai .env di root. Jangan kirim isi rahasia melalui chat atau commit ke Git.
NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://eka:eka_local_change_me@localhost:5432/eka_overview
# Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Google Cloud service account. Lokasi file JSON di komputer SERVER; jangan ditaruh di repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Spreadsheet overview pusat. Harus punya akses service account sebagai Viewer.
GOOGLE_SPREADSHEET_ID=
# Frontend Vite: hanya kunci ANON/PUBLISHABLE yang boleh tersedia di browser.
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
